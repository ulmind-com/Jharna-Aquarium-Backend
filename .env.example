# ─── App ─────────────────────────────────────────────────
APP_NAME="Jharna Aquarium"
ENV=development

# ─── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nursery_ecommerce

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080     # 7 days
ADMIN_TOKEN_EXPIRE_MINUTES=525600     # 1 year

# ─── CORS (comma separated origins) ─────────────────────
CORS_ORIGINS=*

# ─── Razorpay ────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Cloudinary ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Groq AI (Recommendations + Chat Agent) ─────────────
GROQ_API_KEY=
GROQ_AGENT_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=8.0
RECS_USE_LLM=true

# ─── Firebase (token verification / FCM) ────────────────
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# ─── Email (Resend — leave empty to log OTPs in dev) ────
RESEND_API_KEY=
MAIL_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Jharna Aquarium"

# ─── Misc ────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8000
CRON_SECRET=
